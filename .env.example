# LexiMaster server configuration (optional). Copy to .env and export before `npm start`,
# or set these in your hosting provider's dashboard. NEVER prefix with VITE_ —
# Vite would bundle VITE_* variables into the public JavaScript.

# Server-managed key (optional). When set, users may choose "使用服务端托管密钥"
# and the key never reaches the browser.
# AI_PROVIDER=openai            # openai | anthropic | gemini | openai-compatible
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=                  # only for openai-compatible

# Requests per minute per client IP accepted by the proxy (default 60).
# LEXIMASTER_AI_RATE_LIMIT=60

# DEV ONLY: allow http:// and private/loopback base URLs (e.g. a local Ollama or the mock server).
# Leave unset in production — it disables the SSRF guard.
# LEXIMASTER_ALLOW_PRIVATE_BASE_URL=1

# PORT=8787
# HOST=127.0.0.1                # use 0.0.0.0 behind a reverse proxy / in containers
